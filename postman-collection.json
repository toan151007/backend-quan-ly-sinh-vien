              "    pm.expect(body.data.email).to.eql(\"ngocmai@example.com\");",
              "    pm.expect(body.data.maLop).to.eql(\"25CT114\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - T06 Tu choi trung ma (409)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"maSV\": \"SV003\",\n  \"hoTen\": \"Ngọc Mai\",\n  \"email\": \"ngocmai@example.com\",\n  \"maLop\": \"25CT114\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/api/v1/sinh-vien", "host": ["{{baseUrl}}"], "path": ["api", "v1", "sinh-vien"] },
        "description": "T06. Cung body voi request 06 nhung khac dieu kien ban dau: lan nay SV003 DA ton tai.\n\nDieu kien: chay ngay sau 07, KHONG restart server.\nKy vong: 409 Conflict, success=false, message=\"Ma sinh vien da ton tai\".\n\nNHAN 409 LA TEST DAT. Nhan 201 moi la ca that bai.\n\nDay la CA BI TU CHOI (trung ma) dung de chup minh chung."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"T06 - Status la 409 Conflict\", function () {",
              "    pm.response.to.have.status(409);",
              "});",
              "",
              "pm.test(\"T06 - success = false\", function () {",
              "    var body = pm.response.json();",
              "    pm.expect(body.success).to.eql(false);",
              "});",
              "",
              "pm.test(\"T06 - Phai hien bao ma da ton tai\", function () {",
              "    var body = pm.response.json();",
              "    pm.expect(body.message).to.be.a(\"string\");",
              "    pm.expect(body.message).to.include(\"đã tồn tại\");",
              "});"
            ]
          }
        }
      ]
    },
