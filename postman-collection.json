    {
      "name": "06 - T05 Them SV003 (201)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"maSV\": \"SV003\",\n  \"hoTen\": \"Ngọc Mai\",\n  \"email\": \"ngocmai@example.com\",\n  \"maLop\": \"25CT114\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/api/v1/sinh-vien", "host": ["{{baseUrl}}"], "path": ["api", "v1", "sinh-vien"] },
        "description": "T05. POST tao moi nen du lieu nam trong body dang JSON.\n\nDieu kien ban dau: server vua khoi dong, chua co SV003.\nKy vong: 201 Created, success=true, data.maSV=SV003.\n\nDay la CA THANH CONG dung de chup minh chung."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"T05 - Status la 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"T05 - Da tao SV003\", function () {",
              "    var body = pm.response.json();",
              "    pm.expect(body.success).to.eql(true);",
              "    pm.expect(body.data.maSV).to.eql(\"SV003\");",
              "    pm.expect(body.data.hoTen).to.eql(\"Ngọc Mai\");",
              "    pm.expect(body.data.email).to.eql(\"ngocmai@example.com\");",
              "    pm.expect(body.data.maLop).to.eql(\"25CT114\");",
              "});"
            ]
          }
        }
      ]
