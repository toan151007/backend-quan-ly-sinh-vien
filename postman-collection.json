    {
      "name": "12 - T10 Body JSON hong (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"maSV\":\"SV004\"",
