              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"T03 - Tra ve MOT object dung SV001\", function () {",
              "    var body = pm.response.json();",
              "    pm.expect(body.success).to.eql(true);",
              "    pm.expect(body.data).to.be.an(\"object\");",
              "    pm.expect(body.data).to.not.be.an(\"array\");",
              "    pm.expect(body.data.maSV).to.eql(\"SV001\");",
              "    pm.expect(body.data.hoTen).to.eql(\"Minh Nhật\");",
              "});"
            ]
          }
        }
      ]
    },
